{
  "name": "openspeak-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal marketing site for OpenSpeak",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "pages:dev": "wrangler pages dev ./dist",
    "deploy": "vite build && wrangler pages deploy ./dist"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.0",
    "@types/three": "^0.185.4",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "three": "^0.185.1"
  }
}
