{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Yapper",
	"version": "0.1.0",
	"identifier": "vs.stephan.yapper",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Yapper",
				"width": 1240,
				"height": 860,
				"minWidth": 1080,
				"minHeight": 760,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"displayLanguageSelector": true,
				"installMode": "currentUser"
			},
			"webviewInstallMode": {
				"type": "embedBootstrapper"
			}
		}
	}
}
