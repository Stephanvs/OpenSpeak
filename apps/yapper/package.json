{
  "name": "yapper",
  "version": "1.0.0",
  "packageManager": "bun@1.3.10",
  "productName": "Yapper",
  "description": "Electron desktop launcher for Yapper text-to-speech",
  "main": ".vite/build/main.js",
  "author": "Hayman",
  "homepage": "https://github.com/stephanvs/yapper",
  "scripts": {
    "sidecar:build": "node ./build-yap-sidecar.mjs",
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "bun run typecheck:node && bun run svelte-check",
    "start": "electron-forge start",
    "dev": "bun run sidecar:build && electron-forge start",
    "package": "bun run typecheck && bun run sidecar:build && electron-forge package",
    "make": "bun run typecheck && bun run sidecar:build && electron-forge make",
    "publish": "bun run typecheck && bun run sidecar:build && electron-forge publish",
    "build": "bun run package",
    "build:unpack": "bun run package",
    "build:win": "bun run make -- --platform=win32",
    "build:mac": "bun run make -- --platform=darwin",
    "build:linux": "bun run make -- --platform=linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron-forge/shared-types": "^7.10.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^0.577.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.19.1",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
